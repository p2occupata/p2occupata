---
layout: null
permalink: /eventi/archivio.json
---
{% assign oggi = site.time | date: "%Y-%m-%d" %}
{% assign passati = "" | split: "" %}
{% for evento in site.eventi %}
    {% assign evento_data = evento.fine | default: evento.data | date: "%Y-%m-%d" %}
    {% if evento_data < oggi %}
        {% assign passati = passati | push: evento %}
    {% endif %}
{% endfor %}
{% assign passati = passati | sort: "data" | reverse %}
[
{% for evento in passati offset: 8 %}
    {
        "data": {{ evento.data | date: "%Y-%m-%d" | jsonify }},
        "fine": {{ evento.fine | default: evento.data | date: "%Y-%m-%d" | jsonify }},
        "url": {{ evento.url | relative_url | jsonify }},
        "titolo": {{ evento.titolo | jsonify }},
        "categoria": {{ evento.categoria | default: "altro" | jsonify }},
        "categoria_nome": {{ evento.categoria_nome | default: "" | jsonify }},
        "descrizione": {{ evento.descrizione | default: "" | jsonify }},
        "ora": {{ evento.ora | default: "" | jsonify }},
        "luogo": {{ evento.luogo | default: "" | jsonify }},
        "altre_date": {{ evento.date_aggiuntive.size | default: 0 | jsonify }},
        "esempio": {{ evento.esempio | default: false | jsonify }}
    }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
